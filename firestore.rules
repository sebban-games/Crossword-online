rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Jedna gra = jeden dokument games/KOD.
    // Każdy gracz jest zalogowany anonimowo (Firebase Authentication),
    // a jego identyfikator zapisuje się w polu p[0].u albo p[1].u.
    match /games/{code} {

      function signedIn() {
        return request.auth != null;
      }

      // Długość planszy (pola fill i own) dla poziomów 1 do 6, razem z ramką pytań.
      function boardSize(lvl) {
        return lvl <= 2 ? 56 : (lvl <= 4 ? 72 : 80);
      }

      function validPlayer(x) {
        return x is map
          && x.keys().hasOnly(['id', 'n', 'u'])
          && x.keys().hasAll(['id', 'n', 'u'])
          && x.id is string && x.id.size() >= 1 && x.id.size() <= 16
          && x.n is string && x.n.size() >= 1 && x.n.size() <= 48
          && x.u is string && x.u.size() >= 1 && x.u.size() <= 128;
      }

      function intPair(x, lo, hi) {
        return x is list && x.size() == 2
          && x[0] is int && x[1] is int
          && x[0] >= lo && x[0] <= hi
          && x[1] >= lo && x[1] <= hi;
      }

      // Kształt i rozmiar całego dokumentu. Dzięki temu nikt nie zapisze
      // dodatkowych pól ani dużych danych, więc jedna gra waży około 1 KB.
      function validGame(d) {
        return d.keys().hasOnly(['lvl', 'p', 'tt', 'st', 't', 'cur', 'fill', 'own', 'sc', 'sk', 'racks', 'idle', 'hint', 'log', 'hot'])
          && d.keys().hasAll(['lvl', 'p', 'tt', 'st', 't', 'cur', 'fill', 'own', 'sc', 'sk', 'racks', 'idle', 'hint', 'log', 'hot'])
          && d.lvl is int && d.lvl >= 1 && d.lvl <= 6
          && d.tt is int && d.tt in [15, 30, 45, 60, 90, 120, 180]
          && d.st in ['wait', 'play', 'end']
          && d.t is int && d.t >= 0 && d.t <= 2000
          && d.cur is int && d.cur in [0, 1]
          && d.own is string && d.own.size() == boardSize(d.lvl)
          && d.fill is string && d.fill.size() <= 2 * boardSize(d.lvl)
          && intPair(d.sc, -5000, 5000)
          && intPair(d.sk, 0, 2000)
          && d.racks is list && d.racks.size() == 2
          && d.racks[0] is string && d.racks[0].size() <= 16
          && d.racks[1] is string && d.racks[1].size() <= 16
          && d.idle is int && d.idle >= 0 && d.idle <= 2000
          && d.hint is int && d.hint >= -1 && d.hint < 40
          && d.log is string && d.log.size() <= 600
          && d.hot is bool
          && d.p is list && d.p.size() == 2
          && validPlayer(d.p[0])
          && (d.p[1] == null || validPlayer(d.p[1]));
      }

      // Nowa gra zawsze startuje od pustej planszy i zera punktów,
      // a twórca może wpisać tylko siebie.
      function validNewGame(d) {
        return validGame(d)
          && d.p[0].u == request.auth.uid
          && d.fill.matches('^[.]+$') && d.fill.size() == boardSize(d.lvl)
          && d.own.matches('^[.]+$')
          && d.sc[0] == 0 && d.sc[1] == 0
          && d.sk[0] == 0 && d.sk[1] == 0
          && d.idle == 0 && d.hint == -1 && d.cur == 0
          && (
            (d.p[1] == null && d.st == 'wait' && d.t == 0 && d.hot == false)
            || (d.p[1] != null && d.p[1].u == request.auth.uid && d.st == 'play' && d.t == 1 && d.hot == true)
          );
      }

      // Dołączenie drugiej osoby do gry, która czeka w lobby.
      function isJoin(o, n) {
        return o.st == 'wait' && o.p[1] == null
          && n.st == 'play' && n.t == 1
          && n.p[0] == o.p[0]
          && n.p[1] != null && n.p[1].u == request.auth.uid
          && n.fill == o.fill && n.own == o.own
          && n.diff(o).affectedKeys().hasOnly(['p', 'st', 't', 'cur', 'racks', 'log']);
      }

      // Ruch w trwającej grze. Może go zapisać tylko jeden z dwóch graczy,
      // zawsze o jedną turę do przodu i ze zmianą punktów tylko osoby,
      // która miała ruch. Drugi gracz może zapisać przepadnięcie tury rywala.
      function isMove(o, n) {
        return o.st == 'play'
          && (request.auth.uid == o.p[0].u || request.auth.uid == o.p[1].u)
          && n.p == o.p
          && n.t == o.t + 1
          && n.st in ['play', 'end']
          && n.cur == 1 - o.cur
          && n.sc[1 - o.cur] == o.sc[1 - o.cur]
          && n.sc[o.cur] - o.sc[o.cur] >= -5
          && n.sc[o.cur] - o.sc[o.cur] <= 120
          && n.own.size() == o.own.size()
          && n.diff(o).affectedKeys().hasOnly(['fill', 'own', 'sc', 'sk', 'idle', 'hint', 'cur', 't', 'st', 'racks', 'log']);
      }

      // Odczyt jednej gry po kodzie. Przeglądanie listy wszystkich gier jest zablokowane.
      allow get: if signedIn() && code.size() == 4;
      allow list: if false;

      allow create: if signedIn()
        && code.size() == 4
        && code.matches('^[A-Z]{4}$')
        && validNewGame(request.resource.data);

      allow update: if signedIn()
        && validGame(request.resource.data)
        && request.resource.data.lvl == resource.data.lvl
        && request.resource.data.tt == resource.data.tt
        && request.resource.data.hot == resource.data.hot
        && (isJoin(resource.data, request.resource.data) || isMove(resource.data, request.resource.data));

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
